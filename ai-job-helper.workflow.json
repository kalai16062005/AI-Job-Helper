    {
      "parameters": {
        "jsCode": "const html = $json.data || \"\";\n\n// Remove tags first\nconst text = html.replace(/<[^>]*>/g, \"\").replace(/\\+/g, \"\");\n\n// Extract main job description\nconst match = text.match(/Job Summary: (.*?) Similar jobs/);\n\nconst cleaned = match\n  ? match[1].trim().substring(0, 8000)\n  : text.substring(0, 8000);\n\nreturn [\n  {\n    cleaned_html: cleaned\n  }\n];"
      },
