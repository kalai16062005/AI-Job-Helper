    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an ATS resume optimizer.\n\nCompare the job requirements with the candidate's resume and provide structured\noptimization.\n\nJob Description:\nRequired Skills : {{ $json.output.required_skills }}\n\nResponsibilities : {{ $json.output.responsibilities }}\n\nExperience Required : {{ $json.output.experience_required }}\n\nCandidate Resume:\n{{ $json.text }}\n\nReturn ONLY valid JSON in this exact format:\n{\n  \"skill_gaps\": [\"skill1\", \"skill2\"],\n  \"resume_improvements\": [\"improvement1\", \"improvement2\"],\n  \"optimized_resume\": \"full optimized resume text here\",\n  \"match_score\": 85\n}\n\nDo NOT add any markdown formatting or extra text.\n",
        "hasOutputParser": true,
        "options": {}
