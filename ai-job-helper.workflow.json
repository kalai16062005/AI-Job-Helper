      "parameters": {
        "sendTo": "={{ $('On form submission').item.json.Email }}",
        "subject": "=Your AI Job Match Report - {{ $('JD Analyzer').item.json.output.job_title || 'Job Application' }}",
        "message": "=<div style=\"font-family: Arial, Helvetica, sans-serif; max-width: 700px; margin: auto; line-height: 1.6; color: #222;\">\n\n  <h2 style=\"margin-bottom: 5px;\">\n    AI Job Match Report\n  </h2>\n\n  <p style=\"color: #555; margin-top: 0;\">\n    Hi {{ $('On form submission').item.json['Full Name'] }},\n  </p>\n\n  <hr style=\"border:none;border-top:1px solid #eee;margin:20px 0;\">\n\n  <h3>Job Details</h3>\n\n  <p>\n    <strong>Job Title:</strong>\n    {{ $('JD Analyzer').item.json.output.job_title }}\n  </p>\n\n  <p>\n    <strong>Company:</strong>\n    {{ $('JD Analyzer').item.json.output.company_name }}\n  </p>\n\n  <p>\n    <strong>Location:</strong>\n    {{ $('JD Analyzer').item.json.output.location }}\n  </p>\n\n  <p>\n    <strong>Experience Required:</strong>\n    {{ $('JD Analyzer').item.json.output.experience_required }}\n  </p>\n\n  <p>\n    <strong>Match Score:</strong>\n    <span style=\"font-size:18px;font-weight:bold;color:#2c7be5;\">\n      {{ $json['Match Score'] }}\n    </span>\n  </p>\n\n  <hr style=\"border:none;border-top:1px solid #eee;margin:20px 0;\">\n\n  <h3>Skill Gaps</h3>\n\n  <ul>\n    {{\n      $('Resume Analysis').item.json.output.skill_gaps\n        .map(skill => '<li>' + skill + '</li>')\n        .join('')\n    }}\n  </ul>\n\n  <h3>Resume Improvements</h3>\n\n  <ul>\n    {{\n      $('Resume Analysis').item.json.output.resume_improvements\n        .map(item => '<li>' + item + '</li>')\n        .join('')\n    }}\n  </ul>\n\n  <hr style=\"border:none;border-top:1px solid #eee;margin:20px 0;\">\n\n  <h3>Generated Cover Letter</h3>\n\n  <div style=\"background:#f8f9fb;padding:15px;border-radius:8px;white-space:pre-line;\">\n    {{\n      $('Cover Letter').item.json.output\n        .replace('[Date]', $now.format('MMMM dd, yyyy'))\n    }}\n  </div>\n\n  <hr style=\"border:none;border-top:1px solid #eee;margin:25px 0;\">\n\n  <p style=\"font-size:13px;color:#666;\">\n    This report was generated automatically by your AI Job Assistant.\n  </p>\n\n</div>",
